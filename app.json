{
  "expo": {
    "name": "CampusClubStudent",
    "slug": "CampusClubStudent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kingdipper.CampusClubStudent",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kingdipper.CampusClubStudent"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ffdadcb3-87d0-466c-bc60-56228aced051"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "excludedPackages": [
              "com.ijzerenhein.sharedelement"
            ]
          }
        }
      ]
    ]
  }
}
